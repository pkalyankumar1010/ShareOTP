<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SwiggySMSReader" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_orange</item>
        <item name="colorPrimaryVariant">@color/primary_orange_dark</item>
        <item name="colorOnPrimary">@color/black</item> <!-- Black text on orange in dark mode usually better -->
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Background Colors -->
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="android:statusBarColor">@color/bg_light</item> <!-- Match dark background -->
    </style>

    <style name="Theme.SwiggySMSReader" parent="Base.Theme.SwiggySMSReader" />
</resources>